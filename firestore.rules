rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helper Functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin Verification: Requires verified email AND either bootstrap email or verified admin record
    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.email_verified == true &&
             (
               request.auth.token.email == 'dubeyjonty0@gmail.com' ||
               exists(/databases/$(database)/documents/admins/$(request.auth.uid))
             );
    }

    // Validation for Articles
    function isValidArticle(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
             data.slug is string && data.slug.size() > 0 && data.slug.size() <= 150 &&
             data.excerpt is string && data.excerpt.size() <= 1000 &&
             data.coverImage is string && data.coverImage.size() <= 2048 &&
             data.status in ['draft', 'published'] &&
             data.country == 'India';
    }

    // Validation for Gallery Items
    function isValidGalleryItem(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 2048 &&
             data.state is string && data.state.size() <= 100 &&
             data.destination is string && data.destination.size() <= 100 &&
             data.categorySlug is string && data.categorySlug.size() <= 100 &&
             data.status in ['draft', 'published'];
    }

    // Validation for Destinations
    function isValidDestination(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.slug is string && data.slug.size() > 0 && data.slug.size() <= 150 &&
             data.state is string && data.state.size() > 0 && data.state.size() <= 100 &&
             data.country == 'India';
    }

    // Validation for Categories
    function isValidCategory(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.slug is string && data.slug.size() > 0 && data.slug.size() <= 150;
    }

    // Validation for Booking Enquiries
    function isValidBookingEnquiry(data) {
      return data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 25 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 100 &&
             data.destination is string && data.destination.size() > 0 && data.destination.size() <= 150 &&
             (!('message' in data) || (data.message is string && data.message.size() <= 2000)) &&
             (!('travelDate' in data) || (data.travelDate is string && data.travelDate.size() <= 50)) &&
             (!('travellersCount' in data) || ((data.travellersCount is string && data.travellersCount.size() <= 20) || data.travellersCount is number)) &&
             (!('duration' in data) || (data.duration is string && data.duration.size() <= 50)) &&
             (!('budgetRange' in data) || (data.budgetRange is string && data.budgetRange.size() <= 100)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50) || data.createdAt is timestamp);
    }

    // Validation for Newsletter
    function isValidNewsletter(data) {
      return data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50) || data.createdAt is timestamp);
    }

    // Articles Collection: Public can only read published articles; admin can read drafts and manage
    match /articles/{articleId} {
      allow get: if (existing().status == 'published') || isAdmin();
      allow list: if (resource.data.status == 'published') || isAdmin();
      allow create: if isValidId(articleId) && isAdmin() && isValidArticle(incoming());
      allow update: if isValidId(articleId) && isAdmin() && isValidArticle(incoming());
      allow delete: if isValidId(articleId) && isAdmin();
    }

    // Gallery Collection: Public can only view published frames; admin can manage
    match /gallery/{galleryId} {
      allow get: if (existing().status == 'published') || isAdmin();
      allow list: if (resource.data.status == 'published') || isAdmin();
      allow create: if isValidId(galleryId) && isAdmin() && isValidGalleryItem(incoming());
      allow update: if isValidId(galleryId) && isAdmin() && isValidGalleryItem(incoming());
      allow delete: if isValidId(galleryId) && isAdmin();
    }

    // Destinations Collection: Public can read; only admin can create/edit/delete
    match /destinations/{destinationId} {
      allow read: if true;
      allow create, update: if isValidId(destinationId) && isAdmin() && isValidDestination(incoming());
      allow delete: if isValidId(destinationId) && isAdmin();
    }

    // Categories Collection: Public can read; only admin can create/edit/delete
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming());
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    // Admins Collection:
    // Provisioned strictly server-side via Firebase Admin SDK or Console.
    // Client-side writes are forbidden to prevent self-privilege escalation.
    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if false;
      allow write: if false;
    }

    // Booking Enquiries Collection: Public submit only; admin read/update/delete
    match /enquiries/{enquiryId} {
      allow create: if isValidId(enquiryId) && isValidBookingEnquiry(incoming());
      allow read, update, delete: if isValidId(enquiryId) && isAdmin();
    }

    // Newsletter Subscribers Collection: Public submit only; admin read/update/delete
    match /newsletter/{subscriberId} {
      allow create: if isValidId(subscriberId) && isValidNewsletter(incoming());
      allow read, update, delete: if isValidId(subscriberId) && isAdmin();
    }
  }
}
