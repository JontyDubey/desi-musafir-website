# GEMINI_API_KEY: Optional if using Gemini API features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted
APP_URL="https://your-domain.vercel.app"

# ==============================================================================
# CLOUDINARY CREDENTIALS (Configure in Vercel Project Settings > Environment Variables)
# Never expose CLOUDINARY_API_SECRET to the browser or commit to git.
# ==============================================================================
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ==============================================================================
# FIREBASE ADMIN CONFIGURATION (Configure in Vercel Environment Variables)
# Used by server-side endpoints (/api/cloudinary/sign and /api/cloudinary/delete)
# ==============================================================================
FIREBASE_PROJECT_ID="your-firebase-project-id"

# Optional: Full Firebase Service Account JSON string for local or dedicated environments
# Generated from Firebase Console > Project Settings > Service Accounts > Generate new private key
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"..."}'
